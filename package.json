{
  "name": "binzi",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:hex": "node scripts/check-hex.mjs",
    "audit:check": "node scripts/check-audit.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "e2e:db": "tsx e2e/db-container.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:demo": "tsx src/db/seed-demo.ts",
    "db:studio": "drizzle-kit studio",
    "user:role": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/set-role.ts",
    "db:migrate:binzi-dev": "tsx scripts/binzi-dev.ts migrate",
    "user:role:binzi-dev": "tsx scripts/binzi-dev.ts set-role",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run lint:hex",
    "prepare": "git config core.hooksPath .githooks"
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "^7.29.0"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.53.0",
    "next": "16.4.1",
    "postgres": "3.4.9",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "server-only": "0.0.1",
    "shadcn": "4.21.4",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.7",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}

# BINZI environment variables.
# Values are filled by humans (H-10) — never by the agent, never committed.
# Copy to .env.local for local development; empty values are treated as unset.

# --- App ---
# Required now. App URL, e.g. http://localhost:3000 in local development.
NEXT_PUBLIC_APP_URL=
# Same value as NEXT_PUBLIC_APP_URL. Required from A-09 (Better Auth).
BETTER_AUTH_URL=

# --- Email ---
# "log" (print to server log) or "resend" (deliver via Resend).
# Defaults to "log" in development only; set it explicitly on Vercel
# (Preview & Production) and in CI (A-03).
MAIL_TRANSPORT=
# H-07. Required when MAIL_TRANSPORT=resend; wired up in A-10.
RESEND_API_KEY=
# H-07. Sender address, e.g. BINZI <no-reply@your-domain>. Required when
# MAIL_TRANSPORT=resend.
MAIL_FROM=

# --- Database (Supabase, H-02) ---
# Transaction pooler (port 6543), used by the app. Required from A-07.
DATABASE_URL=
# Session pooler (port 5432), used by drizzle-kit. Required from A-07.
MIGRATION_DATABASE_URL=

# --- Auth ---
# H-10. Random, >= 32 bytes. Required from A-09 (Better Auth).
BETTER_AUTH_SECRET=
# H-06. Required from A-11 (Google login).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# H-05. Required from A-09 (Turnstile on auth forms).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Storage — Cloudflare R2 (H-04). Required from A-17. ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Observability & ops ---
# H-09. Public Sentry DSN; required once the Sentry integration lands.
NEXT_PUBLIC_SENTRY_DSN=
# H-09. CI/Vercel only — never required locally.
SENTRY_AUTH_TOKEN=
# H-10. Random; also stored in GitHub Secrets. Required from A-18 (cron auth).
CRON_SECRET=

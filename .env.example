# ==========================================================================
# BINZI V1 — Environment configuration template (TASK 004)
# ==========================================================================
# Copy this file to `.env` for local development and replace every
# placeholder with real values from the Supabase dashboard
# (Project Settings → API / Database).
#
# `.env`, `.env.local`, and `.env.production` are gitignored — never commit
# real secrets. Only this `.env.example` file with placeholders is committed.
#
# Both Next.js and the drizzle-kit CLI load `.env` automatically.
# ==========================================================================

# --------------------------------------------------------------------------
# Public — safe to expose to the browser (NEXT_PUBLIC_ prefix required).
# Used by the Supabase browser client (TASK 009).
# --------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --------------------------------------------------------------------------
# Server-only — MUST NEVER be referenced from client components.
# --------------------------------------------------------------------------
# Bypasses RLS; used exclusively by privileged server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Direct PostgreSQL connection string used by Drizzle (server-side only).
# Supabase → Project Settings → Database → Connection string (URI).
DATABASE_URL=postgresql://postgres:your-password@your-project-ref.supabase.co:5432/postgres

# Absolute site origin (no trailing slash) used for SEO URL fields:
# canonical URLs, sitemap <loc> entries, and the robots.txt Sitemap
# line (TASK 063). Optional — unset falls back to
# http://localhost:3000. Set to the public origin when deploying.
SITE_URL=http://localhost:3000
